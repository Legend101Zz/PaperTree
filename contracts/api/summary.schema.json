        "pageIndex": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "quads": {
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "polygons": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "type": "array"
        },
        "pageWidth": {
          "type": "number"
        },
        "pageHeight": {
          "type": "number"
        },
        "rotation": {
          "enum": [0, 90, 180, 270],
          "type": "integer"
        },
        "userUnit": {
          "type": "number"
        },
        "cropBox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "type",
        "pageIndex",
        "quads",
        "polygons",
        "pageWidth",
        "pageHeight",
        "rotation",
        "userUnit",
        "cropBox"

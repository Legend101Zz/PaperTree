          "type": "string"
        }
      },
      "required": ["type", "index"],
      "title": "PageSelector",
      "type": "object"
    },
    "SectionPathSelector": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "SectionPathSelector",
          "type": "string"
        },
        "path": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "headingText": {
          "type": "string"
        },

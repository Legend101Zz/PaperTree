      "title": "Citation",
      "type": "object"
    },
    "PageSelector": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "PageSelector",
          "type": "string"
        },
        "index": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },

        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        },
        "exactNormalised": {
          "type": "string"
        },
        "prefixNormalised": {
          "type": "string"
        },
        "suffixNormalised": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "exact",
        "prefix",

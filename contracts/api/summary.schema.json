        "anchorVersion": {
          "const": 1,
          "type": "integer"
        },
        "offsetUnit": {
          "const": "unicode",
          "type": "string"
        },
        "id": {
          "pattern": "^(?:[a-z]{2,4}_[0-9A-Za-z-]{8,64}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
          "type": "string"
        },
        "doc": {
          "$ref": "#/$defs/AnchorDoc"
        },
        "targetKind": {
          "enum": [
            "text",
            "guided_para",
            "equation",
            "equation_part",
            "figure",
            "figure_region",
            "table_row",
            "table_cell",
            "algorithm",
            "citation"
          ],
          "type": "string"
        },
        "provenanceClass": {
          "enum": ["source", "ai_generated"],
          "type": "string"
        },
        "subTarget": {
          "$ref": "#/$defs/SubTarget"
        },
        "selectors": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/BlockSelector"
              },
              {
                "$ref": "#/$defs/PageSelector"
              },
              {
                "$ref": "#/$defs/TextPositionSelector"
              },
              {
                "$ref": "#/$defs/TextQuoteSelector"
              },
              {
                "$ref": "#/$defs/ShapeSelector"
              },
              {
                "$ref": "#/$defs/SectionPathSelector"
              }
            ]
          },
          "type": "array"
        },
        "created": {
          "$ref": "#/$defs/AnchorCreated"
        }
      },
      "required": [
        "anchorVersion",
        "offsetUnit",
        "id",
        "doc",
        "targetKind",
        "provenanceClass",
        "selectors",
        "created"
      ],
      "title": "AnchorV1",
      "type": "object"
    },
    "BlockSelector": {

              "type": "null"
            }
          ]
        },
        "source": {
          "enum": ["arxiv_category", "manual", "model"],
          "type": "string"
        },
        "source_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["topic_id", "name", "cloth", "source", "source_detail"],
      "title": "LibraryTopic",
      "type": "object"
    },

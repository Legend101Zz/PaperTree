    "ReadingProgress": {
      "additionalProperties": false,
      "description": "Where the caller is in a paper (#192). A paper they have not started has `reading: null`.\n\nPages are zero-based. `state` is the progress rule: `finished` once the last page was\nreached (or the paper was marked read), else `reading`.",
      "properties": {

          "type": "string"
        },
        "doc": {
          "$ref": "#/$defs/AnchorDoc"
        },
        "targetKind": {
          "enum": [
            "text",
            "guided_para",
            "equation",
            "equation_part",
            "figure",
            "figure_region",
            "table_row",
            "table_cell",
            "algorithm",
            "citation"
          ],
          "type": "string"
        },
        "provenanceClass": {
          "enum": ["source", "ai_generated"],
          "type": "string"

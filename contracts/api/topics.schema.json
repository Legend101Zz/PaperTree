{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperTree API contract: topics",
  "description": "GENERATED from services/api/python/papertree_api/schemas.py by `uv run python -m papertree_api.contracts export` (contracts.md §0). Do not edit: change the model and re-export. Models: Topic, TopicRef, PaperTopic, LibraryTopic, TopicCreate, TopicPatch, PaperTopicPut.",
  "$defs": {
    "LibraryTopic": {
      "additionalProperties": false,
      "description": "`LibraryPaper.topic`: the topic the caller ACCEPTED for the paper. A mere offer is not\nhere (`GET /papers/{id}/topic` has it): an unaccepted suggestion must not group the shelf.",
      "properties": {
        "topic_id": {
          "pattern": "^top_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cloth": {
          "anyOf": [
            {
              "enum": ["transformers", "vision", "generative", "optimization", "language", "rl"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "const": "accepted",
          "type": "string"
        },
        "source": {
          "enum": ["arxiv_category", "manual", "model"],
          "type": "string"
        },
        "source_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["topic_id", "name", "cloth", "status", "source", "source_detail"],
      "title": "LibraryTopic",
      "type": "object"
    },
    "PaperTopic": {
      "additionalProperties": false,
      "description": "`GET /papers/{id}/topic` and the body of its writes (#193).\n\n`none`: no topic, no offer. `suggested`: an offer (`topic`, or `suggested_name` for a topic\nthat does not exist yet); the paper is NOT shelved. `accepted`: shelved under `topic`.\n`rejected`: the person said no.",
      "properties": {
        "status": {
          "enum": ["none", "suggested", "accepted", "rejected"],
          "type": "string"
        },
        "topic": {
          "anyOf": [
            {
              "$ref": "#/$defs/TopicRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "enum": ["arxiv_category", "manual", "model"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "arxiv_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "topic",
        "suggested_name",
        "source",
        "source_detail",
        "arxiv_category"
      ],
      "title": "PaperTopic",
      "type": "object"
    },
    "PaperTopicPut": {
      "additionalProperties": false,
      "description": "`PUT /papers/{id}/topic`: accept an existing topic, or name a new one (reused if the person\nalready has a topic of that name).\n\nEXACTLY ONE of `topic_id` and `new_topic_name`. The route enforces it (422), not this model:\nevery field here is omittable, which is what the exported schema and `omittable_cases` say.",
      "properties": {
        "topic_id": {
          "pattern": "^top_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "new_topic_name": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
        },
        "cloth": {
          "enum": ["transformers", "vision", "generative", "optimization", "language", "rl"],
          "type": "string"
        }
      },
      "title": "PaperTopicPut",
      "type": "object"
    },
    "Topic": {
      "additionalProperties": false,
      "description": "`GET /topics` (#193): a shelf with what it holds. Counts cover ACCEPTED papers only.",
      "properties": {
        "topic_id": {
          "pattern": "^top_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cloth": {
          "anyOf": [
            {
              "enum": ["transformers", "vision", "generative", "optimization", "language", "rl"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sort_order": {
          "minimum": 0,
          "type": "integer"
        },
        "paper_count": {
          "minimum": 0,
          "type": "integer"
        },
        "page_count": {
          "minimum": 0,
          "type": "integer"
        },
        "categories": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "topic_id",
        "name",
        "cloth",
        "sort_order",
        "paper_count",
        "page_count",
        "categories"
      ],
      "title": "Topic",
      "type": "object"
    },
    "TopicCreate": {
      "additionalProperties": false,
      "description": "`POST /topics`.",
      "properties": {
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
        },
        "cloth": {
          "enum": ["transformers", "vision", "generative", "optimization", "language", "rl"],
          "type": "string"
        }
      },
      "required": ["name"],
      "title": "TopicCreate",
      "type": "object"
    },
    "TopicPatch": {
      "additionalProperties": false,
      "description": "`PATCH /topics/{topic_id}`: only what is sent changes.",
      "properties": {
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
        },
        "cloth": {
          "enum": ["transformers", "vision", "generative", "optimization", "language", "rl"],
          "type": "string"
        },
        "sort_order": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "TopicPatch",
      "type": "object"
    },
    "TopicRef": {
      "additionalProperties": false,
      "description": "A topic as another record points at it.",
      "properties": {
        "topic_id": {
          "pattern": "^top_[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cloth": {
          "anyOf": [
            {
              "enum": ["transformers", "vision", "generative", "optimization", "language", "rl"],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["topic_id", "name", "cloth"],
      "title": "TopicRef",
      "type": "object"
    }
  }
}

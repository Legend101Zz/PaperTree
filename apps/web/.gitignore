# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The pdf.js worker is COPIED here from the installed pdfjs-dist by scripts/copy-pdf-worker.mjs
# on prebuild/predev/pretest. It is a build artefact of a pinned dependency, not source: checking
# in a 1.2 MB minified bundle would put a second, silently-divergable copy of pdf.js in the repo.
/public/pdf.worker.min.mjs

# Staged from packages/document-ir/fixtures/ and research/benchmarks/corpus/ by
# scripts/copy-fixtures.mjs on prebuild/predev/pretest. A second committed copy of files that
# already live in the repo is a second thing to keep in sync.
/public/fixtures/

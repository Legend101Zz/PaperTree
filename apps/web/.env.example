# PaperTree web app (Next.js). Read by `next dev` / `next build` from apps/web/.env.local:
#
#   cp apps/web/.env.example apps/web/.env.local
#
# The list is exactly research/build/reader-release/contracts.md section 7, the web rows.
# Variables prefixed NEXT_PUBLIC_ are baked into the browser bundle: never put a secret here.
# The web app never sees the model key; only the agent process does.

# The API's origin, as the BROWSER reaches it (default http://localhost:8000). This is the only
# base-URL variable. 127.0.0.1 is used here on purpose: browse the app at http://127.0.0.1:3000
# too, because Chrome keeps a saved zoom level per host name and "localhost" often carries one.
NEXT_PUBLIC_PAPERTREE_API_URL=http://127.0.0.1:8000

# Sample papers and the demo fixtures: off (default). "on" is for tests and demos only.
# NEXT_PUBLIC_PAPERTREE_FIXTURES=off

        { "rule": "I1", "severity": "error", "path": "blocks[6].block_id" },
        { "rule": "I1", "severity": "error", "path": "blocks[7].block_id" },
        { "rule": "I1", "severity": "error", "path": "blocks[8].block_id" },
        { "rule": "I1", "severity": "error", "path": "blocks[9].block_id" },
        { "rule": "I1", "severity": "error", "path": "blocks[10].block_id" },
        { "rule": "I1", "severity": "error", "path": "blocks[11].block_id" }
      ]
    },
    {
      "name": "I1-disabled-for-a-hand-written-fixture",
      "note": "the one legitimate use of disabled_rules, and the reason the option exists",
      "options": { "disabled_rules": ["I1"] },
      "ops": [
        {
          "set": "source_hash",
          "value": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
        }
      ],

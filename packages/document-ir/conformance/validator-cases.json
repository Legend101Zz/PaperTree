    },

    {
      "name": "R10-block-claims-a-page-that-does-not-list-it",
      "ops": [{ "delete": "pages/0/block_ids/4" }],
      "expect": [{ "rule": "R10", "severity": "error", "path": "pages[0].block_ids" }]
